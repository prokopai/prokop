{
  "name": "@prokopai/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The agent process for the host/agent split (docs/plans/host-agent-split.md): the Prokop runtime and the Claude Code and Codex drivers. Imports @prokopai/core, @prokopai/agent-protocol and @prokopai/sdk, never @prokopai/server.",
  "scripts": {
    "start": "bun src/main.ts --stdio",
    "test": "bun test ./src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.278",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@prokopai/agent-protocol": "workspace:*",
    "@prokopai/core": "workspace:*",
    "@prokopai/sdk": "workspace:*",
    "adm-zip": "^0.5.16",
    "ai": "^6.0.116",
    "ignore": "^7.0.5",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.9.124",
    "picomatch": "^4.0.2",
    "turndown": "^7.2.0",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2",
    "zod": "^4.4.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./internal/*": "./src/*.ts"
  },
  "imports": {
    "#agent/*": "./src/*.ts"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/bun": "^1.3.11",
    "@types/node": "^22.19.15",
    "@types/picomatch": "^4.0.1",
    "@types/turndown": "^5.0.5",
    "@types/xml2js": "^0.4.14",
    "bun-types": "^1.3.9",
    "typescript": "^5.7.2"
  }
}
